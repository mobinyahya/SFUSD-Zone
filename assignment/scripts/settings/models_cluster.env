# Settings for scripts/run_models_estimates.sh — cluster / production run.
#
# This file is sourced by the pipeline script. Every value uses the
# `: "${VAR:=default}"` form so that an environment variable set before
# invoking the script always takes precedence over the file.
#
# Machine-specific paths live HERE, not in the script or in Python code.

# -- Interpreter --------------------------------------------------------------
: "${PYTHON_CMD:=uv run python}"

# -- Input data ---------------------------------------------------------------
# Directory containing SFUSD-Choice model outputs:
#   <SFUSD_MODELS_DIR>/<model>/estimates_<year>.csv
: "${SFUSD_MODELS_DIR:=<SFUSD_CHOICE_PATH>/local_outputs/models}"
# Filtered student CSVs: <STUDENT_DIR>/student_<year>_filtered.csv
: "${STUDENT_DIR:=./local-data/student_filter}"
# Filtered program CSVs:
#   <PROGRAM_DIR>/programs_without_specialprogs_<year>.csv
: "${PROGRAM_DIR:=./local-data/program_filter}"
# School CSVs: <SCHOOL_DATA_DIR>/schools_rehauled_<year>.csv
: "${SCHOOL_DATA_DIR:=/share/data/school_choice/Data/Cleaned}"
# SFUSD shared-data root (paths.sfusd in the generated configs).
: "${SFUSD_DATA_DIR:=/share/data/school_choice/Data/}"
# Zone definition files referenced by the generated configs.
: "${ZONES_DIR:=/share/data/school_choice/simulation-files/zones}"

# -- Outputs ------------------------------------------------------------------
: "${RUNS_ROOT:=./local-data/local-runs/models_runs}"
: "${CFG_DIR:=configs/models_configs}"
: "${ANALYSIS_CFG:=configs/models/models_estimates.yaml}"
: "${OUTPUT_DIR:=metrics/models}"
: "${LOG_DIR:=local-data/logs/models_simulations}"

# -- Evaluator inputs (analyze_trends) ----------------------------------------
# Optional .npy array of census blocks for the et2 equity flag ("" = none).
: "${ANALYSIS_NEW_CTIP_PATH:=/share/data/school_choice/Data/2025_cleaned_data/Cleaned_new/ETB_2024.npy}"

# -- Simulation parameters ----------------------------------------------------
: "${GRADE:=KG}"
: "${RANDOM_SEED:=2023}"
: "${ITER_START:=0}"
: "${ITER_END:=25}"
# Maximum number of run_custom_config processes active at once.
: "${SIMULATION_WORKERS:=4}"
# Training year + suffix used to build model names:
#   <family>_<TRAIN_YEAR>_k<k>_<MODEL_SUFFIX>
: "${TRAIN_YEAR:=2223}"
: "${MODEL_SUFFIX:=prog_gesplit}"

# -- Run matrix (bash arrays; not overridable via environment) ----------------
MODEL_FAMILIES=(alternative baseline selected)
K_VALUES=(1 3 5)
# test_year : 2-digit year : sample tag (oos = out-of-sample, is = in-sample)
TEST_SPECS=("2324:23:oos" "2223:22:is")
# suffix : list-length expression for the utility model
LIST_LENGTH_VARIANTS=(
    "ll0p8:0.8*round(real_length)"
    "ll0p7:0.7*round(real_length)"
    "ll0p6:0.6*round(real_length)"
    "ll7:7"
)
