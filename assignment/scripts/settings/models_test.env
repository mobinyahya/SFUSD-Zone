# Settings for scripts/run_models_estimates.sh — tiny fake-data run.
#
# Drives the end-to-end pipeline against the committed fixtures in
# tests/fixtures/fake_2223/ (see tests/test_full_pipeline.py). Output
# locations (RUNS_ROOT, CFG_DIR, ANALYSIS_CFG, OUTPUT_DIR, LOG_DIR) are
# expected to be overridden via environment variables by the test, but
# get safe repo-local defaults below.

: "${PYTHON_CMD:=uv run python}"

# -- Input data: committed fake fixtures --------------------------------------
: "${FIXTURES_DIR:=tests/fixtures/fake_2223}"
: "${SFUSD_MODELS_DIR:=${FIXTURES_DIR}/models}"
: "${STUDENT_DIR:=${FIXTURES_DIR}}"
: "${PROGRAM_DIR:=${FIXTURES_DIR}}"
: "${SCHOOL_DATA_DIR:=${FIXTURES_DIR}/Cleaned}"
# Never actually read with fully-explicit data paths, but must be set.
: "${SFUSD_DATA_DIR:=${FIXTURES_DIR}/}"
: "${ZONES_DIR:=${FIXTURES_DIR}/zones}"

# -- Outputs (tests override these with a tmp dir) -----------------------------
: "${RUNS_ROOT:=local-data/local-runs/fake_pipeline_test}"
: "${CFG_DIR:=local-data/local-runs/fake_pipeline_test/configs}"
: "${ANALYSIS_CFG:=local-data/local-runs/fake_pipeline_test/analysis.yaml}"
: "${OUTPUT_DIR:=local-data/local-runs/fake_pipeline_test/metrics}"
: "${LOG_DIR:=local-data/local-runs/fake_pipeline_test/logs}"

# -- Evaluator inputs ----------------------------------------------------------
: "${ANALYSIS_SCHOOLS_DATA:=${FIXTURES_DIR}/Cleaned/schools_rehauled_2223.csv}"
: "${ANALYSIS_NEW_CTIP_PATH:=}"

# -- Simulation parameters ------------------------------------------------------
: "${GRADE:=KG}"
: "${RANDOM_SEED:=2023}"
: "${ITER_START:=0}"
: "${ITER_END:=2}"
: "${TRAIN_YEAR:=2223}"
: "${MODEL_SUFFIX:=prog_gesplit}"

# -- Run matrix: one fake model, in-sample year only ---------------------------
MODEL_FAMILIES=(selectedfake)
K_VALUES=(1)
TEST_SPECS=("2223:22:is")
LIST_LENGTH_VARIANTS=(
    "ll0p8:0.8*round(real_length)"
    "ll7:7"
)
